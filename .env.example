# Demo mode: payments and screening are simulated, nothing touches a chain.
IPAY_MODE=demo
PORT=3000

# ---- Live mode (Arc Testnet or mainnet) ----
# IPAY_MODE=live
# COMPLIR_MODE=live
# EARN_CHAIN=Arc_Testnet            # Arc for mainnet
# IPAY_ALLOW_MAINNET=YES            # required only when EARN_CHAIN=Arc

# Circle developer-controlled wallets (TEST_API_KEY for testnet, LIVE_API_KEY for mainnet)
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_ADDRESS=0x...       # operator wallet; business wallets are created at signup
# EARN_VAULT_ADDRESS=0x...          # Circle Earn USDC vault

# Admin key for the operator view, at least 32 random characters
# IPAY_OWNER_TOKEN=

# Payments agent: Claude if set, otherwise OpenAI, otherwise built-in rules
# ANTHROPIC_API_KEY=
# IPAY_AGENT_MODEL=claude-opus-5-5
# OPENAI_API_KEY=
# IPAY_OPENAI_MODEL=gpt-5.4-mini

# Storage: PostgreSQL if set, otherwise JSON files in IPAY_DATA_DIR
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# IPAY_DATA_DIR=.data

# Optional tuning
# IPAY_SIGNUPS_PER_HOUR=5
# IPAY_SIGNUPS_PER_DAY=500
# IPAY_GAS_RESERVE_USDC=0.10
# ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# ARC_EXPLORER_URL=https://explorer.arc.io
# COMPLIR_URL=https://trycomplir.xyz
