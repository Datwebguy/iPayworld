# Defaults to a local, simulated workflow with no onchain transactions.
IPAY_MODE=demo
PORT=3000

# Optional: use real CompliR risk screening while funds stay simulated.
# COMPLIR_MODE=live
# COMPLIR_URL=https://trycomplir.xyz
# COMPLIR_ATTESTER=0xc742ada2872a042dd36d2e706907b4036968960c

# Optional read-only balance for an existing Circle Agent Wallet on Arc Testnet.
# ARC_WALLET_ADDRESS=0x...
# ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Live Earn Kit USDC vault CLI (Circle developer-controlled wallet).
# EARN_CHAIN=Arc_Testnet
# CIRCLE_API_KEY=...
# CIRCLE_ENTITY_SECRET=...
# CIRCLE_WALLET_ADDRESS=0x...
# EARN_VAULT_ADDRESS=0x...

# Enable the live milestone release server only after configuring the values above.
# Replace IPAY_MODE=demo at the top with IPAY_MODE=live.
# COMPLIR_MODE=live
# IPAY_OWNER_TOKEN=generate-a-random-secret-of-at-least-32-characters
# IPAY_ALLOW_MAINNET=YES  # Required only when EARN_CHAIN=Arc
# IPAY_GAS_RESERVE_USDC=0.10
# ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Hosted multi-tenant persistence (Railway Postgres in the deployed environment).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
